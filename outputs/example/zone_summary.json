    "dlogr_sonic": "DlogR = log10(RT / RT_baseline) + 0.02 * (DT - DT_baseline)   [DT in us/ft]",
    "toc": "TOC [wt%] = DlogR * 10^(2.297 - 0.1688 * LOM); negative values set to 0; set to 0 where Vsh < min_vsh   [Passey et al. 1990]",
